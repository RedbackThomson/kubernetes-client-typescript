{
  "name": "kubernetes-client-typescript",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "pnpm -r --sort run build",
    "check": "pnpm -r --sort run check",
    "clean": "pnpm -r --sort run clean",
    "dev": "pnpm --filter react-resource-browser dev",
    "kts": "pnpm --filter @kubernetes-typescript/generator kts",
    "test": "pnpm -r --sort run test"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
