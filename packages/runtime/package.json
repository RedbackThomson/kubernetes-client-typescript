{
  "name": "@kubernetes-typescript/runtime",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedbackThomson/kubernetes-client-typescript",
    "directory": "packages/runtime"
  },
  "version": "0.1.0-alpha.4",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
