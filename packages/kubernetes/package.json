{
  "name": "@kubernetes-typescript/kubernetes",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./resources": {
      "types": "./dist/resources/index.d.ts",
      "default": "./dist/resources/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@kubernetes-typescript/runtime": "workspace:*"
  },
  "files": ["dist"]
}

